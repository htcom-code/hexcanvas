{
  "name": "hexcanvas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && tsc -p tsconfig.test.json && pnpm test",
    "check:publish": "pnpm build && node scripts/check-publish.mjs",
    "verify:registry": "pnpm build && node scripts/verify-registry.mjs",
    "dev": "pnpm --filter demo dev",
    "test": "vitest run --project core",
    "test:browser": "vitest run --project browser",
    "bench": "vitest bench --project core",
    "api": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "api:docs": "pnpm --filter @hexcanvas/docs-tools exec typedoc --options typedoc.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  }
}
